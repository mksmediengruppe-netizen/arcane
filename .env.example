# ═══════════════════════════════════════════════
# ARCANE Environment Configuration
# ═══════════════════════════════════════════════

# ── LLM Providers ──
OPENAI_API_KEY=sk-...                    # Обязательный. GPT-5 Nano/Mini/5/5.4, o3, GPT-4.1
OPENROUTER_API_KEY=sk-or-...             # Обязательный. Claude Opus/Sonnet, Gemini, DeepSeek

# ── Search Providers ──
TAVILY_API_KEY=tvly-...                  # Основной поиск. https://tavily.com
SERPER_API_KEY=                          # Бюджетный Google. https://serper.dev
EXA_API_KEY=                             # Семантический поиск. https://exa.ai
BRAVE_API_KEY=                           # Fallback. https://brave.com/search/api

# ── Deploy ──
VERCEL_TOKEN=                            # Деплой лендингов. https://vercel.com/account/tokens
CLOUDFLARE_API_TOKEN=                    # DNS + Pages. https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ZONE_ID=                      # ID зоны домена

# ── Database ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arcane
POSTGRES_USER=arcane
POSTGRES_PASSWORD=

# ── Vector DB ──
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arcane_memory

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Storage ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=arcane-artifacts

# ── n8n ──
N8N_URL=http://localhost:5678
N8N_API_KEY=

# ── Strategy ──
DEFAULT_MODEL_STRATEGY=balance           # economy | balance | quality | maximum
DEFAULT_BUDGET_LIMIT=5.00                # Максимум $ за проект

# ── Application ──
ARCANE_ENV=production
ARCANE_DEBUG=false
ARCANE_HOST=0.0.0.0
ARCANE_PORT=8100
ARCANE_SECRET_KEY=change-me-in-production

# ── Rate Limits ──
MAX_PARALLEL_PROJECTS=3
RATE_LIMIT_OPENAI_RPM=60
RATE_LIMIT_OPENROUTER_RPM=30

# ── Self-Healing ──
MAX_HEAL_ITERATIONS=5
MAX_TIER_ESCALATIONS=2
SANDBOX_TIMEOUT=60
